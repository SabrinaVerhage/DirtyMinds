# Copy to .env. Keep your real key out of Git and screenshots.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# The window switches override these settings until the app is restarted.
ELEVENLABS_WHISPER=true
ELEVENLABS_WHISPER_MODEL_ID=eleven_v4
ELEVENLABS_VOICE_EFFECTS=true
# Actual silence inserted between separately whispered phrases (0 to 3000 ms).
ELEVENLABS_WHISPER_PAUSE_MS=900
# Arduino sketch below sends raw 10-bit ADC counts at 115200 baud.
SERIAL_PORT=
SERIAL_BAUD=115200
FEATHER_HOST=
GSR_MAX=1023
# Absolute change from baseline that maps to 100% (tune for your sensor).
GSR_SPAN=200

# Three whispered diagnostic stimuli.
VOICE_ONION=sP3q7DZvU8X3maXCONzw
VOICE_OLIVE=qMeZLxL57iwdz7D3XC3e
VOICE_JALAPENO=ZwLTvq6uCfb4W00YFl7F
# Separate spoken professor for intake, instructions, and discharge.
VOICE_PROFESSOR=onwK4e9ZLuTAKqWW03F9

# Arduino Uno running uno_pump_controller.
PUMP_PORT=
# Optional legacy settings. The Hardware console can save calibration without editing this file.
ENABLE_REAL_PUMPS=false
# Enable real mode only after water tests and individual flow calibration.
# Legacy only: measured ml/second for the original onion, olive, jalapeno channel order.
PUMP_ML_PER_SECOND=

# Optional. Names the martini and enables Fresh script at startup.
# OpenAI receives fictional character briefs for the script and brine amounts for the name.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

