# Copy to .env. Keep your real key out of Git and screenshots.
ELEVENLABS_API_KEY=
# Host voice. Default for new installs: Nora. Existing .env is preserved.
ELEVENLABS_VOICE_ID=1ykC5GeLM4dP82qkyo91
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# The window switches override these settings until the app is restarted.
ELEVENLABS_WHISPER=true
ELEVENLABS_WHISPER_MODEL_ID=eleven_v4
ELEVENLABS_VOICE_EFFECTS=true
# Actual silence inserted between separately whispered phrases (0 to 3000 ms).
ELEVENLABS_WHISPER_PAUSE_MS=900
# Arduino sketch below sends raw 10-bit ADC counts at 115200 baud.
SERIAL_PORT=
SERIAL_BAUD=115200
FEATHER_HOST=
GSR_MAX=1023
# Absolute change from baseline that maps to 100% (tune for your sensor).
GSR_SPAN=200

# Four temptations: one voice per brine. Override with any accessible voice ID.
VOICE_ONION=1ykC5GeLM4dP82qkyo91
VOICE_OLIVE=PB6BdkFkZLbI39GHdnbQ
VOICE_JALAPENO=A6TsrDqI2qlO9AWAfZHY
VOICE_PICKLE=1cxc5c3E9K6F1wlqOJGV

# Arduino Uno running uno_pump_controller.
PUMP_PORT=
# Leave false until calibrated. The app starts in screen rehearsal.
ENABLE_REAL_PUMPS=false
# Enable real mode only after water tests and individual flow calibration.
# Four measured ml/second values in onion, olive, jalapeno, pickle order. No assumed rates.
PUMP_ML_PER_SECOND=

# Optional. Enables Fresh pitches at startup. Only fictional cast and approaches
# go to OpenAI. Turn it off in the app to rehearse with the prepared house script.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

